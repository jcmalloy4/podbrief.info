# PodBrief Website Environment Variables

# Backend API URL (replace with your actual backend service URL)
BACKEND_URL=https://your-backend-url.a.run.app

# Firebase Configuration
# Path to your Firebase service account key file
# GOOGLE_APPLICATION_CREDENTIALS=path/to/your/firebase-service-account-key.json

# Or if using GCP service account (recommended for GCP deployment)
# The service account should have Firebase Admin SDK permissions

# App Store URLs (update with your actual app IDs)
# These are used in the app redirect logic
IOS_APP_ID=your-app-id
ANDROID_PACKAGE_ID=com.johncmalloy4.PodBrief

# Image URLs
# Update these with your actual logo and default image URLs
LOGO_IMAGE_URL=https://podbrief.info/Assets/podbrief_logo.png
DEFAULT_IMAGE_URL=https://podbrief.info/Assets/podbrief_preview.png

# Local development environment variables

# Firebase configuration
FIREBASE_API_KEY=your-firebase-api-key
NODE_ENV=development

# Note: The server will use fallback data if the backend URL is not reachable 